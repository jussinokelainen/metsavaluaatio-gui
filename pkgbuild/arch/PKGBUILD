# Maintainer: Jussi Nokelainen <jussinoke@gmail.com>
#
# Tämä paketti sisältää vain GPUI-pohjaisen graafisen sovelluksen.

pkgname='metsavaluaatio-gui'
pkgver=0.1.0
pkgrel=1
pkgdesc='Metsäomaisuuden arviointi GPUI-työpöytäsovelluksella'
arch=('x86_64')
url='ssh://git@github.com:jussinokelainen/metsavaluaatio-gui.git'
license=('AGPL-3.0-only')
depends=(
	'glibc'
	'gcc-libs'
	'sqlite'
	'libxkbcommon'
	'libxkbcommon-x11'
	'wayland'
	'libx11'
	'libxcb'
	'freetype2'
	'fontconfig'
	'libxcursor'
	'vulkan-icd-loader'
)
makedepends=('git' 'cargo' 'cmake' 'sqlite')
optdepends=(
	'xdg-utils: selaimen ja tulostekansion avaaminen'
	'vulkan-intel: Vulkan-ajuri Intelin näytönohjaimille'
	'vulkan-radeon: Vulkan-ajuri AMD:n näytönohjaimille'
	'nvidia-utils: Vulkan-ajuri NVIDIA:n näytönohjaimille'
)
source=("$pkgname::git+$url#tag=$pkgver")
options=('!debug' '!lto')
sha256sums=('SKIP')

prepare() {
	cd "$pkgname"
	cargo fetch --locked
}

build() {
	cd "$pkgname"
	export CARGO_TARGET_DIR=target
	cargo build --release --frozen --bin metsaval-gui
}

package() {
	cd "$pkgname"
	install -Dm755 target/release/metsaval-gui "$pkgdir/usr/bin/metsaval-gui"
}
