# Maintainer: Jussi Nokelainen <jussinoke@gmail.com>

pkgname='metsavaluaatio-gui'
pkgver=0.4.0
pkgrel=1
pkgdesc='Työpöytäsovellus metsän analysointiin'
arch=('x86_64')
url='ssh://git@github.com:jussinokelainen/metsavaluaatio-gui.git'
license=('AGPL-3.0-only')
depends=(
	'glibc'
	'gcc-libs'
	'sqlite'
	'libxkbcommon'
	'libxkbcommon-x11'
	'wayland'
	'libx11'
	'libxcb'
	'freetype2'
	'fontconfig'
	'libxcursor'
	'vulkan-icd-loader'
)
makedepends=('git' 'cargo' 'cmake' 'sqlite')
optdepends=(
	'xdg-utils: selaimen ja tulostekansion avaaminen'
	'vulkan-intel: Vulkan-ajuri Intelin näytönohjaimille'
	'vulkan-radeon: Vulkan-ajuri AMD:n näytönohjaimille'
	'nvidia-utils: Vulkan-ajuri NVIDIA:n näytönohjaimille'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/jussinokelainen/$pkgname/archive/refs/tags/$pkgver.tar.gz")

options=('!debug' '!lto')
sha256sums=('SKIP')

prepare() {
	cd "$pkgname-$pkgver"

	cargo fetch --locked
}

build() {
	cd "$pkgname-$pkgver"
	export CARGO_TARGET_DIR=target
	cargo build --release --frozen --bin metsaval-gui
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 target/release/metsaval-gui "$pkgdir/usr/bin/metsaval-gui"

	# Install .desktop file
	install -Dm644 /dev/stdin \
		"$pkgdir/usr/share/applications/metsavaluaatio.desktop" <<EOF
[Desktop Entry]
Name=Metsävaluaatio
GenericName=Metsäomaisuuden arviointi
Comment=Metsäomaisuuden arviointi GPUI-työpöytäsovelluksella
Exec=metsaval-gui
Terminal=false
Type=Application
Categories=Office;Finance;
EOF
}
