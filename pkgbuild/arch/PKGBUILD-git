# Maintainer: Jussi Nokelainen <jussinoke@gmail.com>
#
# Package version that follows the latest git commit.
# Tämä paketti sisältää vain GPUI-pohjaisen graafisen sovelluksen.

_pkgname='metsavaluaatio-gui'
pkgname="$_pkgname-git"
pkgver=r98.aea9575
pkgrel=1
pkgdesc='Metsäomaisuuden arviointi GPUI-työpöytäsovelluksella (git)'
arch=('x86_64')
url='ssh://git@gitlab.internal.nokehub.net:222/jussinokelainen/metsavaluaatio-gui.git'
license=('AGPL-3.0-only')
depends=(
	'glibc'
	'gcc-libs'
	'sqlite'
	'libxkbcommon'
	'libxkbcommon-x11'
	'wayland'
	'libx11'
	'libxcb'
	'freetype2'
	'fontconfig'
	'libxcursor'
	'vulkan-icd-loader'
)
makedepends=('git' 'cargo' 'cmake' 'sqlite')
optdepends=(
	'xdg-utils: selaimen ja tulostekansion avaaminen'
	'vulkan-intel: Vulkan-ajuri Intelin näytönohjaimille'
	'vulkan-radeon: Vulkan-ajuri AMD:n näytönohjaimille'
	'nvidia-utils: Vulkan-ajuri NVIDIA:n näytönohjaimille'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url")
options=('!debug' '!lto')
sha256sums=('SKIP')

pkgver() {
	cd "$_pkgname"
	printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
	cd "$_pkgname"
	cargo fetch --locked
}

build() {
	cd "$_pkgname"
	export CARGO_TARGET_DIR=target
	cargo build --release --frozen --bin metsaval-gui
}

package() {
	cd "$_pkgname"
	install -Dm755 target/release/metsaval-gui "$pkgdir/usr/bin/metsaval-gui"
}
