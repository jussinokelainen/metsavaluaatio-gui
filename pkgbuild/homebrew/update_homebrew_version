#!/usr/bin/env bash

# This script can be used to update the metsavaluaatio-gui.rb files in this directory,
# and in the homebrew-metsavaluaatio-gui repository which should be cloned into this
# directory.
# The script takes the new version as an argument.
#
# Usage example, updating to version 1.2.3:
# ./update_homebrew_version 1.2.3

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$SCRIPT_DIR/../.." && pwd)
REMOTE="ssh://git@gitlab.internal.nokehub.net:222/jussinokelainen/metsavaluaatio-gui.git"
DEFAULT_VERSION=$(grep -m1 '^version' "$ROOT/Cargo.toml" | cut -d'"' -f2)
VERSION=${1:-$DEFAULT_VERSION}
FORMULA="$SCRIPT_DIR/metsavaluaatio-gui.rb"
TAP="$SCRIPT_DIR/homebrew-metsavaluaatio/Formula"

if ! git -C "$ROOT" rev-parse -q --verify "refs/tags/$VERSION" >/dev/null; then
	echo "Varoitus: tagia $VERSION ei löytynyt paikallisesta reposta." >&2
fi

cat <<EOF >"$FORMULA"
class MetsavaluaatioGui < Formula
  desc "Metsäomaisuuden arviointi GPUI-työpöytäsovelluksella"
  homepage "$REMOTE"
  url "$REMOTE",
      using: :git,
      tag: "$VERSION"
  version "$VERSION"
  license "AGPL-3.0-only"

  depends_on "rust" => :build
  depends_on "cmake" => :build
  depends_on "sqlite"

  def install
    system "cargo", "install", "--bin", "metsaval-gui", *std_cargo_args
  end
end
EOF

echo "Generated $FORMULA (tag $VERSION)."

if [[ -d "$TAP" ]]; then
	cp "$FORMULA" "$TAP/metsavaluaatio-gui.rb"
	echo "Copied formula to $TAP."
else
	echo "homebrew-metsavaluaatio checkout not found; skipping copy."
	exit 0
fi

if [[ ! -d "$SCRIPT_DIR/homebrew-metsavaluaatio/.git" ]]; then
	exit 0
fi

message="Update metsavaluaatio-gui to $VERSION"
read -p "Commit and push formula with message '$message'? [y/n] " -r
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
	exit 0
fi

cd "$SCRIPT_DIR/homebrew-metsavaluaatio"
# Poista vanha CLI-formula, jotta tap sisältää vain GUI-sovelluksen.
git rm --ignore-unmatch ./Formula/metsavaluaatio.rb >/dev/null 2>&1 || true
git add ./Formula/metsavaluaatio-gui.rb
git commit -m "$message"
git push
