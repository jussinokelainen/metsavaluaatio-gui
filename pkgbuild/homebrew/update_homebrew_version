#!/usr/bin/env bash

# This script can be used to update the metsavaluaatio-gui.rb files in this directory,
# and in the homebrew-metsavaluaatio-gui repository which should be cloned into this
# directory.
# The script takes the new version as an argument.
#
# Usage example, updating to version 1.2.3:
# ./update_homebrew_version 1.2.3

VERSION=$1
FILENAME="Metsavaluaatio-macos.app.zip"
shasum=$(curl -L https://github.com/jussinokelainen/metsavaluaatio-gui/releases/download/"$VERSION"/"$FILENAME" | sha256sum)
shasum=${shasum%% *}
empty_shasum="d5558cd419c8d46bdc958064cb97f963d1ea793866414c025906ec15033512ed"
if [[ "$shasum" == "$empty_shasum" ]]; then
    printf "\e[31m404\e[0m: https://github.com/jussinokelainen/metsavaluaatio-gui/releases/download/%s/%s not found.\n" "$VERSION" "$FILENAME"
    exit 1
else
    printf "New sha256sum: \e[32m%s\e[0m\n" "$shasum"
fi

read -p "Update formula files? [y/n] " -r
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    exit 0
fi

cat <<EOF >metsavaluaatio-gui.rb
cask "metsavaluaatio-gui" do
    version "$VERSION"
    sha256 "$shasum"

    url "https://github.com/jussinokelainen/metsavaluaatio-gui/releases/download/#{version}/$FILENAME"

    name "Metsävaluaatio"
    desc "Työpöytäsovellus metsän analysointiin"
    homepage "https://github.com/jussinokelainen/metsavaluaatio-gui"

    app "Metsavaluaatio.app"

    postflight_steps do
        run "/usr/bin/xattr",
            args: [
                "-dr",
                "com.apple.quarantine",
                "{{appdir}}/Metsavaluaatio.app"
            ]
    end
end
EOF

cp ./metsavaluaatio-gui.rb ./homebrew-metsavaluaatio/Casks/metsavaluaatio-gui.rb
printf '{"version": "%s"}\n' "$VERSION" >./homebrew-metsavaluaatio/gui_version.json
echo "Formula files updated."

message="Updated gui cask to version $VERSION"
printf "Commit new metsavaluaatio-gui.rb in homebrew-metsavaluaatio with message '\e[32m%s\e[0m'?" "$message"
read -p " [y/n] " -r
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    exit 0
fi

cd ./homebrew-metsavaluaatio/ || exit
git add ./Casks/metsavaluaatio-gui.rb ./gui_version.json
git commit -m "$message"
git push
